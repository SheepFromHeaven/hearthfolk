{
  "id": "inhabitant_screen",
  "modId": "minenow",
  "width": 200,
  "height": 190,
  "actions": ["go_home", "view_inventory", "issues"],
  "bindingsSchema": {
    "inhabitant_name":  { "type": "string", "previewValue": "Alice" },
    "dominion_name":    { "type": "string", "previewValue": "My Dominion" },
    "job_status":       { "type": "string", "previewValue": "Job: Lumberjack" },
    "issues_btn_label": { "type": "string", "previewValue": "Issues" },
    "shelter":          { "type": "number", "previewValue": 0.8 },
    "food":             { "type": "number", "previewValue": 0.6 },
    "rest":             { "type": "number", "previewValue": 0.4 }
  },
  "widgets": [
    {
      "id": "panel_main", "type": "panel",
      "x": 0, "y": 0, "w": 200, "h": 190,
      "text": "", "icon": null,
      "props": { "style": "default" }
    },
    {
      "id": "label_name", "type": "label",
      "x": 0, "y": 8, "w": 200, "h": 10,
      "text": "Inhabitant", "icon": null,
      "props": { "color": "-12566464", "shadow": "false", "align": "center" },
      "parentId": "panel_main",
      "bindings": { "text": "inhabitant_name" }
    },
    {
      "id": "label_dominion", "type": "label",
      "x": 0, "y": 22, "w": 200, "h": 10,
      "text": "Dominion", "icon": null,
      "props": { "color": "-7810816", "shadow": "false", "align": "center" },
      "parentId": "panel_main",
      "bindings": { "text": "dominion_name" }
    },
    {
      "id": "tabs_main", "type": "tabs",
      "x": 0, "y": 40, "w": 200, "h": 150,
      "text": "", "icon": null,
      "props": {},
      "parentId": "panel_main"
    },

    { "id": "tab_general", "type": "tab", "x": 0, "y": 0, "w": 0, "h": 0, "text": "General", "icon": null, "props": {}, "parentId": "tabs_main" },
    { "id": "tab_needs",   "type": "tab", "x": 0, "y": 0, "w": 0, "h": 0, "text": "Needs",   "icon": null, "props": {}, "parentId": "tabs_main" },
    { "id": "tab_debug",   "type": "tab", "x": 0, "y": 0, "w": 0, "h": 0, "text": "Debug",   "icon": null, "props": {}, "parentId": "tabs_main" },

    {
      "id": "btn_go_home", "type": "button",
      "x": 10, "y": 10, "w": 180, "h": 20,
      "text": "Go Home", "icon": null, "props": {},
      "parentId": "tab_general", "action": "go_home"
    },
    {
      "id": "btn_view_inventory", "type": "button",
      "x": 10, "y": 36, "w": 180, "h": 20,
      "text": "View Inventory", "icon": null, "props": {},
      "parentId": "tab_general", "action": "view_inventory"
    },
    {
      "id": "btn_issues", "type": "button",
      "x": 10, "y": 62, "w": 180, "h": 20,
      "text": "Issues", "icon": null, "props": {},
      "parentId": "tab_general", "action": "issues",
      "bindings": { "text": "issues_btn_label" }
    },
    {
      "id": "label_job_status", "type": "label",
      "x": 10, "y": 92, "w": 180, "h": 10,
      "text": "Job: Idle", "icon": null,
      "props": { "color": "-12566464", "shadow": "false", "align": "center" },
      "parentId": "tab_general",
      "bindings": { "text": "job_status" }
    },

    {
      "id": "label_needs_title", "type": "label",
      "x": 10, "y": 10, "w": 180, "h": 8,
      "text": "Needs", "icon": null,
      "props": { "color": "-12566464", "shadow": "false" },
      "parentId": "tab_needs"
    },
    {
      "id": "label_shelter", "type": "label",
      "x": 20, "y": 28, "w": 160, "h": 8,
      "text": "Shelter", "icon": null,
      "props": { "color": "-12566464", "shadow": "false" },
      "parentId": "tab_needs"
    },
    {
      "id": "progress_shelter", "type": "progress",
      "x": 20, "y": 38, "w": 160, "h": 10,
      "text": "", "icon": null,
      "props": { "min": "0", "max": "1", "show_label": "true" },
      "parentId": "tab_needs"
    },
    {
      "id": "label_food", "type": "label",
      "x": 20, "y": 58, "w": 160, "h": 8,
      "text": "Food", "icon": null,
      "props": { "color": "-12566464", "shadow": "false" },
      "parentId": "tab_needs"
    },
    {
      "id": "progress_food", "type": "progress",
      "x": 20, "y": 68, "w": 160, "h": 10,
      "text": "", "icon": null,
      "props": { "min": "0", "max": "1", "show_label": "true" },
      "parentId": "tab_needs"
    },
    {
      "id": "label_rest", "type": "label",
      "x": 20, "y": 88, "w": 160, "h": 8,
      "text": "Rest", "icon": null,
      "props": { "color": "-12566464", "shadow": "false" },
      "parentId": "tab_needs"
    },
    {
      "id": "progress_rest", "type": "progress",
      "x": 20, "y": 98, "w": 160, "h": 10,
      "text": "", "icon": null,
      "props": { "min": "0", "max": "1", "show_label": "true" },
      "parentId": "tab_needs"
    },

    {
      "id": "list_debug", "type": "list",
      "x": 3, "y": 6, "w": 194, "h": 116,
      "text": "", "icon": null,
      "props": { "item_height": "10" },
      "parentId": "tab_debug",
      "item_template": [
        { "type": "label", "id": "text", "x": 4, "y": 1, "w": 192, "h": 8, "text": "", "icon": null, "props": { "color": "-12566464" } }
      ]
    }
  ]
}
